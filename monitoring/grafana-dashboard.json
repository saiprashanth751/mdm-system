{
    "annotations": {
        "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "panels": [
        {
            "title": "Device Registrations",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "mdm_device_registered_total",
                    "legendFormat": "Total Registrations"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 1000
                            },
                            {
                                "color": "red",
                                "value": 10000
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Heartbeat Rate (per second)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 4
            },
            "targets": [
                {
                    "expr": "rate(mdm_heartbeat_received_total[5m])",
                    "legendFormat": "Heartbeats/sec"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 20
                    },
                    "color": {
                        "mode": "palette-classic"
                    }
                }
            }
        },
        {
            "title": "Heartbeat Redis Buffer — Flush Stats",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 4
            },
            "targets": [
                {
                    "expr": "rate(mdm_heartbeat_flush_total[5m])",
                    "legendFormat": "Devices Flushed/sec"
                },
                {
                    "expr": "rate(mdm_heartbeat_flush_errors[5m])",
                    "legendFormat": "Flush Errors/sec"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 15
                    }
                }
            }
        },
        {
            "title": "Kafka — Schedule Approvals Processed",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 0
            },
            "targets": [
                {
                    "expr": "mdm_kafka_schedule_processed_total",
                    "legendFormat": "Processed"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Kafka — Devices Notified (Async)",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "mdm_kafka_devices_notified_total",
                    "legendFormat": "Total Notified"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Kafka — Failed Schedule Processing",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 0
            },
            "targets": [
                {
                    "expr": "mdm_kafka_schedule_failed_total",
                    "legendFormat": "Failures"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Update State Transitions (per minute)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 12
            },
            "targets": [
                {
                    "expr": "rate(mdm_update_state_transition_total[1m]) * 60",
                    "legendFormat": "{{from_state}} → {{to_state}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "bars",
                        "lineWidth": 1,
                        "fillOpacity": 80
                    }
                }
            }
        },
        {
            "title": "Kafka Consumer Lag",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 12
            },
            "targets": [
                {
                    "expr": "kafka_consumer_fetch_manager_records_lag_max{client_id=~\".*mdm.*\"}",
                    "legendFormat": "Max Lag — {{topic}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 10
                    },
                    "color": {
                        "fixedColor": "orange",
                        "mode": "fixed"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 100
                            },
                            {
                                "color": "red",
                                "value": 1000
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "JVM Heap Usage",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 20
            },
            "targets": [
                {
                    "expr": "jvm_memory_used_bytes{area=\"heap\"} / 1024 / 1024",
                    "legendFormat": "Used (MB)"
                },
                {
                    "expr": "jvm_memory_max_bytes{area=\"heap\"} / 1024 / 1024",
                    "legendFormat": "Max (MB)"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "decmbytes",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 15
                    }
                }
            }
        },
        {
            "title": "HikariCP — Active DB Connections",
            "type": "gauge",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 20
            },
            "targets": [
                {
                    "expr": "hikaricp_connections_active{pool=\"HikariPool-1\"}",
                    "legendFormat": "Active"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "min": 0,
                    "max": 20,
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 12
                            },
                            {
                                "color": "red",
                                "value": 18
                            }
                        ]
                    }
                }
            }
        }
    ],
    "schemaVersion": 39,
    "tags": [
        "mdm",
        "spring-boot",
        "kafka",
        "redis"
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "timepicker": {},
    "timezone": "browser",
    "title": "MDM System — Production Dashboard",
    "uid": "mdm-system-dashboard",
    "version": 1
}